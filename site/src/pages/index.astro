---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { LinkButton } from '@astrojs/starlight/components';
import PaperRow from '../components/PaperRow.astro';
import Video from '../components/Video.astro';
import { allPapers, firstListed } from '../lib/papers';

const papers = await allPapers();
// Group by the month a paper was first listed, newest first (arXiv-style listing).
const monthFmt = new Intl.DateTimeFormat('en', { year: 'numeric', month: 'long', timeZone: 'UTC' });
const groups = new Map<string, typeof papers>();
for (const p of papers) {
	const month = monthFmt.format(new Date(`${firstListed(p)}T00:00:00Z`));
	groups.set(month, [...(groups.get(month) ?? []), p]);
}
---

<StarlightPage
	frontmatter={{
		title: 'Instead of only publishing a paper, publish an agent.',
		template: 'splash',
		description: 'New papers published with the Agentic Publication Protocol. Each one is a GitHub repository you can open in a coding agent.',
		head: [{ tag: 'link', attrs: { rel: 'alternate', type: 'application/json', href: '/papers/index.json' } }],
	}}
>
	<div class="catalog">
		<div class="intro">
			<div>
				<p class="lede">
					An APP paper is a GitHub repository that carries the paper together with its code, data, and the authors'
					know-how. Open it in Claude Code, Codex, or any agent that reads <code>AGENTS.md</code>, and the agent speaks
					for the paper: it can explain the work, reproduce figures, run experiments, and answer questions grounded in it.
				</p>
				<div class="actions">
					<LinkButton href="/publish/" icon="right-arrow">Publish your paper</LinkButton>
					<LinkButton href="/about/" variant="secondary">Why APP</LinkButton>
				</div>
			</div>
			<Video src="/media/app-promo.mp4" poster="/media/app-promo.jpg" label="APP in 70 seconds" />
		</div>

		<h2 class="listing">New papers</h2>
		<div class="bar">
			<p class="count"><span id="shown">{papers.length}</span> of {papers.length} papers, newest first</p>
			<input id="q" type="search" placeholder="Search titles, authors, tags" aria-label="Search papers" autocomplete="off" />
		</div>

		{
			[...groups].map(([month, list]) => (
				<section class="month" data-month>
					<h2>{month}</h2>
					<ul>
						{list.map((paper) => <PaperRow paper={paper} />)}
					</ul>
				</section>
			))
		}
		<p id="empty" hidden>No papers match your search.</p>
	</div>
</StarlightPage>

<script>
	const q = document.getElementById('q') as HTMLInputElement;
	const shown = document.getElementById('shown')!;
	const empty = document.getElementById('empty')!;
	const months = [...document.querySelectorAll<HTMLElement>('[data-month]')];
	q.addEventListener('input', () => {
		const terms = q.value.toLowerCase().split(/\s+/).filter(Boolean);
		let n = 0;
		for (const month of months) {
			let inMonth = 0;
			for (const row of month.querySelectorAll<HTMLElement>('[data-search]')) {
				const hit = terms.every((t) => row.dataset.search!.includes(t));
				row.hidden = !hit;
				if (hit) inMonth++;
			}
			month.hidden = inMonth === 0;
			n += inMonth;
		}
		shown.textContent = String(n);
		empty.hidden = n > 0;
	});
</script>

<style>
	.catalog { max-width: 60rem; }
	.intro {
		display: grid;
		grid-template-columns: 1.25fr 1fr;
		gap: 1.5rem 2.5rem;
		align-items: center;
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--sl-color-hairline);
	}
	.lede { margin: 0; font-size: var(--sl-text-lg); line-height: 1.55; color: var(--sl-color-gray-1); max-width: 34rem; }
	.actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.25rem; }
	@media (max-width: 50rem) { .intro { grid-template-columns: 1fr; } }
	.listing { margin-top: 2rem; font-size: var(--sl-text-2xl); }
	.bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem; margin-top: 0.75rem; }
	.count { margin: 0; color: var(--sl-color-gray-3); font-size: var(--sl-text-sm); }
	#q {
		flex: 0 1 20rem;
		padding: 0.45rem 0.7rem;
		font: inherit;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-white);
		background: var(--sl-color-bg);
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.4rem;
	}
	#q:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 1px; }
	.month h2 { font-size: var(--sl-text-base); color: var(--sl-color-gray-3); font-weight: 600; margin-top: 1.75rem; }
	.month ul { list-style: none; padding: 0; margin-top: 0.25rem; }
	#empty { color: var(--sl-color-gray-3); font-size: var(--sl-text-sm); }
</style>
