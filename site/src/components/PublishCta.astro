---
import { LinkButton } from '@astrojs/starlight/components';
import { url } from '../lib/url';
---

<aside class="publish-cta">
	<p><strong>Want your paper here?</strong> Publish it with its own agent.</p>
	<LinkButton href={url('/publish/')} icon="right-arrow">Publish your paper</LinkButton>
</aside>

<style>
	.publish-cta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		margin-top: 2rem;
		padding: 0.75rem 1rem;
		background: var(--sl-color-accent-low);
		border-radius: 0.5rem;
	}
	.publish-cta p { margin: 0; }
</style>
