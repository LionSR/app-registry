---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { url } from '../lib/url';
import { agentCommand } from '../lib/agent-command';

// Set at build time. PUBLIC_SUBMIT_API is the function's base URL, e.g.
// https://<project-ref>.supabase.co/functions/v1/registry. Without these the page says submissions are not configured.
const api = import.meta.env.PUBLIC_SUBMIT_API ?? '';
const clientId = import.meta.env.PUBLIC_GITHUB_APP_CLIENT_ID ?? '';
const configured = Boolean(api && clientId);
// Filled in with the chosen release by the page script.
const agentCmd = agentCommand(api, 'https://github.com/OWNER/REPO/releases/tag/TAG');
---

<StarlightPage
	frontmatter={{
		title: 'Submit to the registry',
		template: 'splash',
		description: 'List your APP release on this site.',
	}}
>
	<div class="submit" data-api={api} data-client-id={clientId}>
		<p class="lede">
			Submit a release you have already <a href={url('/publish/')}>published</a>. The registry checks that it is a verified APP
			publication, and an editor lists it with a permanent ID. Your repository is not changed.
		</p>

		<form id="form" novalidate>
			<div class="account">
				<span id="who">Sign in with GitHub so the registry knows who is submitting.</span>
				<button type="button" id="signin" class="secondary" disabled={!configured}>Sign in with GitHub</button>
				<button type="button" id="signout" class="link" hidden>Sign out</button>
			</div>

			<label for="repo">Repository</label>
			<input id="repo" class="field" name="repo" required autocomplete="off" list="repo-suggestions" placeholder="owner/paper-repo" />
			<datalist id="repo-suggestions"></datalist>
			<p class="hint">A public GitHub repository. Type <code>owner/</code> to choose from its repositories, or paste a URL.</p>

			<label for="tag">Release</label>
			<select id="tag" class="field" name="tag" disabled><option>Choose a repository first</option></select>
			<p class="hint">Only releases with an <code>APP_PUBLICATION.json</code> file can be submitted.</p>

			<p id="preview" class="preview" hidden></p>

			<fieldset>
				<legend>Your relationship to the paper</legend>
				<label><input type="radio" name="relationship" value="author" checked /> I am an author</label>
				<label><input type="radio" name="relationship" value="coauthor" /> I am a co-author</label>
				<label><input type="radio" name="relationship" value="on-behalf" /> I am submitting on behalf of the authors</label>
			</fieldset>

			<div id="status" class="status" data-tone="info" role="status" aria-live="polite"></div>
			<button type="submit" id="send" disabled>Submit to the registry</button>
		</form>

		<h2>What happens next</h2>
		<ol>
			<li>A submission issue opens in the registry repository, and you are mentioned in it.</li>
			<li>The checks run within a minute and post the result there. If something fails, fix the release and comment <code>/recheck</code>.</li>
			<li>An editor reviews the submission and lists it, or replies with a reason. Reply in the same issue to respond.</li>
		</ol>

		<details class="agents">
			<summary>Submit from an agent or a script</summary>
			<p>
				Coding agents can submit the same way, with no browser. The request below uses your GitHub CLI login to say who is
				submitting; nothing else is sent. You can also paste it to your agent and ask it to run it.
			</p>
			<pre><code id="agent-cmd">{agentCmd}</code></pre>
			<button type="button" id="copy-cmd" class="secondary">Copy command</button>
		</details>
	</div>
</StarlightPage>

<script>
	import '../scripts/submit.ts';
</script>

<style>
	.submit { max-width: 40rem; }
	.agents { margin-top: 2rem; }
	.agents summary { cursor: pointer; font-weight: 600; }
	.agents pre { white-space: pre-wrap; word-break: break-all; font-size: var(--sl-text-xs); padding: 0.75rem; border-radius: 0.35rem; background: var(--sl-color-gray-6); }
	form { display: grid; gap: 0.5rem; margin-top: 1.5rem; padding: 1.25rem; border: 1px solid var(--sl-color-gray-5); border-radius: 0.5rem; }
	.account { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem 1rem; padding-bottom: 1rem; margin-bottom: 0.5rem; border-bottom: 1px solid var(--sl-color-hairline); }
	label, legend { font-weight: 600; }
	fieldset { border: 0; padding: 0; margin: 0.75rem 0 0.5rem; display: grid; gap: 0.35rem; }
	fieldset label { font-weight: 400; display: flex; gap: 0.5rem; align-items: center; margin: 0; }
	.preview { margin: 0.25rem 0 0; padding: 0.6rem 0.8rem; font-family: var(--app-serif); font-size: var(--sl-text-lg); background: var(--sl-color-gray-6); border-radius: 0.35rem; }
	.status { margin-top: 0.75rem; padding: 0.7rem 0.9rem; border-radius: 0.4rem; border-inline-start: 3px solid; font-size: var(--sl-text-sm); line-height: 1.5; }
	.status:empty { display: none; }
	.status[data-tone='info'] { border-color: var(--sl-color-gray-4); background: var(--sl-color-gray-6); }
	.status[data-tone='ok'] { border-color: var(--sl-color-green); background: var(--sl-color-green-low); }
	.status[data-tone='warn'] { border-color: var(--sl-color-orange); background: var(--sl-color-orange-low); }
	.status[data-tone='error'] { border-color: var(--sl-color-red); background: var(--sl-color-red-low); }
	.status button.link { font-size: inherit; }
	.hint { margin: 0; font-size: var(--sl-text-sm); color: var(--sl-color-gray-3); }
	button { font: inherit; font-weight: 600; padding: 0.55rem 1.1rem; border-radius: 999px; border: 0; cursor: pointer; color: var(--sl-color-black); background: var(--sl-color-accent); justify-self: start; }
	button.secondary { background: transparent; color: var(--sl-color-white); border: 1px solid var(--sl-color-gray-4); }
	button.link { background: none; padding: 0; color: var(--sl-color-accent); font-weight: 400; text-decoration: underline; }
	button:disabled { opacity: 0.45; cursor: not-allowed; }
	button:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
</style>
