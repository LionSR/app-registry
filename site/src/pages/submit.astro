---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Code } from '@astrojs/starlight/components';
import { url } from '../lib/url';

// Set at build time. PUBLIC_SUBMIT_API is the function's base URL, e.g.
// https://<project-ref>.supabase.co/functions/v1/registry. Without these the page says submissions are not configured.
const api = import.meta.env.PUBLIC_SUBMIT_API ?? '';
const clientId = import.meta.env.PUBLIC_GITHUB_APP_CLIENT_ID ?? '';
const configured = Boolean(api && clientId);
const agentCmd = `curl -X POST ${api || 'https://<project-ref>.supabase.co/functions/v1/registry'}/submit \\
  -H "Authorization: Bearer $(gh auth token)" \\
  -H "Content-Type: application/json" \\
  -d '{"release_url": "https://github.com/owner/repo/releases/tag/v1.0.0", "relationship": "author"}'`;
---

<StarlightPage
	frontmatter={{
		title: 'Submit to the registry',
		template: 'splash',
		description: 'List your APP release on this site.',
	}}
>
	<div class="submit" data-api={api} data-client-id={clientId}>
		<p class="lede">
			Submit a release you have already <a href={url('/publish/')}>published</a>. The registry checks that it is a verified APP
			publication, and an editor lists it with a permanent ID. Your repository is not changed.
		</p>

		{
			!configured && (
				<p class="notice">Submissions are not configured on this build of the site.</p>
			)
		}

		<form id="form" novalidate>
			<div class="account">
				<span id="who">Sign in with GitHub so the registry knows who is submitting.</span>
				<button type="button" id="signin" class="secondary" disabled={!configured}>Sign in with GitHub</button>
				<button type="button" id="signout" class="link" hidden>Sign out</button>
				<p id="signin-error" class="error" role="alert" hidden></p>
			</div>

			<label for="repo">Repository</label>
			<input id="repo" name="repo" required autocomplete="off" list="repo-suggestions" placeholder="owner/paper-repo" aria-describedby="repo-hint" />
			<datalist id="repo-suggestions"></datalist>
			<p id="repo-hint" class="hint">A public GitHub repository. Type <code>owner/</code> to choose from its repositories, or paste a URL.</p>

			<label for="tag">Release</label>
			<select id="tag" name="tag" disabled aria-describedby="tag-hint"><option>Choose a repository first</option></select>
			<p id="tag-hint" class="hint">Only releases with an <code>APP_PUBLICATION.json</code> file can be submitted. A tag names one fixed version of the paper.</p>

			<p id="preview" class="preview" hidden></p>

			<fieldset>
				<legend>Your relationship to the paper</legend>
				<label><input type="radio" name="relationship" value="author" checked /> I am an author</label>
				<label><input type="radio" name="relationship" value="coauthor" /> I am a co-author</label>
				<label><input type="radio" name="relationship" value="on-behalf" /> I am submitting on behalf of the authors</label>
			</fieldset>

			<button type="submit" id="send" disabled>Submit to the registry</button>
			<p id="result" role="status" aria-live="polite"></p>
		</form>

		<h2>What happens next</h2>
		<ol>
			<li>A submission issue opens in the registry repository, and you are mentioned in it.</li>
			<li>The checks run within a minute and post the result there. If something fails, fix the release and comment <code>/recheck</code>.</li>
			<li>An editor reviews the submission and lists it, or replies with a reason. Reply in the same issue to respond.</li>
		</ol>

		<h2>Submit from an agent</h2>
		<p>Agents use the same endpoint. The GitHub CLI token identifies you.</p>
		<Code code={agentCmd} lang="bash" />
	</div>
</StarlightPage>

<script>
	import { parseRelease } from '../../../submit/supabase/functions/_shared/submission.ts';

	const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
	const root = document.querySelector<HTMLElement>('.submit')!;
	const api = root.dataset.api!;
	const clientId = root.dataset.clientId!;
	const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
	const form = $<HTMLFormElement>('form');
	const preview = $('preview');
	const send = $<HTMLButtonElement>('send');
	const result = $('result');
	const who = $('who');
	const TOKEN = 'app-registry-token';
	const STATE = 'app-registry-oauth-state';

	const store = {
		get: (k: string) => { try { return sessionStorage.getItem(k); } catch { return null; } },
		set: (k: string, v: string) => { try { sessionStorage.setItem(k, v); } catch {} },
		del: (k: string) => { try { sessionStorage.removeItem(k); } catch {} },
	};

	// Back from GitHub sign-in: the callback puts the token (or an error) in the fragment.
	const signinError = $('signin-error');
	const showSigninError = (msg: string) => {
		signinError.textContent = msg;
		signinError.hidden = false;
	};
	const back = new URLSearchParams(location.hash.slice(1));
	if (back.has('state')) {
		history.replaceState(null, '', location.pathname);
		if (back.get('state') !== store.get(STATE)) showSigninError('Sign-in could not be verified. Sign in again from this tab.');
		else if (back.get('error')) showSigninError(back.get('error')!);
		else if (back.get('token')) store.set(TOKEN, back.get('token')!);
		store.del(STATE);
	}

	let login = '';
	async function loadAccount() {
		const token = store.get(TOKEN);
		if (!token) return;
		const res = await fetch('https://api.github.com/user', { headers: { Authorization: `Bearer ${token}` } });
		if (!res.ok) {
			store.del(TOKEN);
			return showSigninError(`GitHub did not accept the sign-in (${res.status}). Sign in again.`);
		}
		login = (await res.json()).login;
		who.textContent = `Signed in as @${login}`;
		$('signin').hidden = true;
		$('signout').hidden = false;
		suggestRepos(login);
		if (tagSelect.value && !tagSelect.disabled) selectRelease();
	}

	$('signin').addEventListener('click', () => {
		const state = crypto.randomUUID();
		store.set(STATE, state);
		const q = new URLSearchParams({ client_id: clientId, redirect_uri: `${api}/auth/callback`, state });
		location.href = `https://github.com/login/oauth/authorize?${q}`;
	});
	$('signout').addEventListener('click', () => {
		store.del(TOKEN);
		location.reload();
	});

	// Repository and release pickers. Public GitHub data only; the signed-in token just raises rate limits.
	const repoInput = $<HTMLInputElement>('repo');
	const repoHint = $('repo-hint');
	const suggestions = $('repo-suggestions');
	const tagSelect = $<HTMLSelectElement>('tag');
	const tagHint = $('tag-hint');
	const gh = (path: string) => {
		const token = store.get(TOKEN);
		return fetch(`https://api.github.com${path}`, { headers: token ? { Authorization: `Bearer ${token}` } : {} });
	};
	let listed: { id: string; repo_url: string; versions: { tag: string }[] }[] = [];
	fetch(`${BASE}/papers/index.json`).then((r) => r.json()).then((d) => (listed = d)).catch(() => {});

	const suggested = new Set<string>();
	async function suggestRepos(owner: string) {
		if (suggested.has(owner.toLowerCase())) return;
		suggested.add(owner.toLowerCase());
		const res = await gh(`/users/${encodeURIComponent(owner)}/repos?per_page=100&sort=updated&type=owner`);
		if (!res.ok) return;
		for (const r of await res.json()) {
			if (r.private || r.fork) continue;
			suggestions.append(Object.assign(document.createElement('option'), { value: r.full_name }));
		}
	}

	/** "owner/repo", a repo URL, or a release URL -> { owner, repo, tag? } */
	function readRepo(text: string) {
		const t = text.trim().replace(/\.git$/, '').replace(/\/$/, '');
		const m = t.match(/^(?:https:\/\/github\.com\/)?([\w.-]+)\/([\w.-]+)(?:\/(?:releases\/tag|tree)\/([^\s?#]+))?$/);
		return m ? { owner: m[1], repo: m[2], tag: m[3] ? decodeURIComponent(m[3]) : undefined } : null;
	}

	let current = '';
	async function loadReleases() {
		const text = repoInput.value.trim();
		const owner = text.match(/^(?:https:\/\/github\.com\/)?([\w.-]+)\/$/)?.[1];
		if (owner) suggestRepos(owner);
		const r = readRepo(text);
		tagSelect.disabled = true;
		send.disabled = true;
		preview.hidden = true;
		if (!r) {
			current = '';
			tagSelect.innerHTML = '<option>Choose a repository first</option>';
			return;
		}
		const key = `${r.owner}/${r.repo}`.toLowerCase();
		if (key === current) return;
		current = key;
		repoHint.textContent = `Looking up ${r.owner}/${r.repo}…`;
		const res = await gh(`/repos/${r.owner}/${r.repo}/releases?per_page=100`);
		if (current !== key) return;
		if (!res.ok) {
			repoHint.textContent = res.status === 404 ? `${r.owner}/${r.repo} was not found. It must be a public repository.` : `GitHub returned ${res.status}. Try again in a minute.`;
			tagSelect.innerHTML = '<option>No releases</option>';
			return;
		}
		const releases: { tag_name: string; name: string; draft: boolean; assets: { name: string }[] }[] = await res.json();
		const eligible = releases.filter((x) => !x.draft && x.assets.some((a) => a.name === 'APP_PUBLICATION.json'));
		repoHint.textContent = `${r.owner}/${r.repo}: ${releases.length} release${releases.length === 1 ? '' : 's'}, ${eligible.length} with APP_PUBLICATION.json.`;
		tagSelect.innerHTML = '';
		for (const x of releases.filter((x) => !x.draft)) {
			const ok = eligible.includes(x);
			const opt = Object.assign(document.createElement('option'), {
				value: x.tag_name,
				textContent: ok ? x.tag_name : `${x.tag_name} (no APP_PUBLICATION.json)`,
				disabled: !ok,
			});
			tagSelect.append(opt);
		}
		if (!eligible.length) {
			tagSelect.innerHTML = '<option>No release can be submitted yet</option>';
			// A fork rarely carries the publication; point to the repository it was forked from.
			const meta = await gh(`/repos/${r.owner}/${r.repo}`).then((x) => (x.ok ? x.json() : null));
			if (current !== key) return;
			const parent: string | undefined = meta?.fork ? meta.parent?.full_name : undefined;
			if (parent) {
				tagHint.textContent = `${r.owner}/${r.repo} is a fork of ${parent}. The publication is usually in the original repository. `;
				const use = Object.assign(document.createElement('button'), { type: 'button', className: 'link', textContent: `Use ${parent}` });
				use.addEventListener('click', () => {
					repoInput.value = parent;
					loadReleases();
				});
				tagHint.append(use);
			} else {
				tagHint.innerHTML = `Publish the paper first: the <a href="${BASE}/publish/">publishing skill</a> creates the release and its APP_PUBLICATION.json.`;
			}
			return;
		}
		tagSelect.disabled = false;
		tagSelect.value = r.tag && eligible.some((x) => x.tag_name === r.tag) ? r.tag : eligible[0].tag_name;
		selectRelease();
	}

	async function selectRelease() {
		const r = readRepo(repoInput.value);
		const tag = tagSelect.value;
		if (!r || !tag) return;
		send.disabled = !login;
		// Registry status, from the site's own listing.
		const entry = listed.find((e) => e.repo_url.toLowerCase() === `https://github.com/${r.owner}/${r.repo}`.toLowerCase());
		const status = !entry
			? 'New paper for the registry.'
			: entry.versions.some((v) => v.tag === tag)
				? `Already listed as ${entry.id}. Nothing to submit.`
				: `New version of ${entry.id}.`;
		if (entry?.versions.some((v) => v.tag === tag)) send.disabled = true;
		tagHint.textContent = status;
		preview.hidden = false;
		preview.textContent = `Reading AGENTS.md at ${tag}…`;
		const res = await fetch(`https://raw.githubusercontent.com/${r.owner}/${r.repo}/${encodeURIComponent(tag)}/AGENTS.md`);
		if (tagSelect.value !== tag) return;
		if (!res.ok) {
			preview.textContent = `No AGENTS.md at ${tag}. The checks will fail without it.`;
			return;
		}
		const text = await res.text();
		const title = text.match(/^title:\s*["']?(.*?)["']?\s*$/m)?.[1];
		const names = [...text.matchAll(/^\s*-\s+name:\s*["']?(.*?)["']?\s*$/gm)].map((m) => m[1]);
		preview.textContent = title ? `${title}${names.length ? `, by ${names.join(', ')}` : ''}` : `Found AGENTS.md at ${tag}.`;
	}

	repoInput.addEventListener('input', loadReleases);
	tagSelect.addEventListener('change', selectRelease);

	form.addEventListener('submit', async (e) => {
		e.preventDefault();
		const picked = readRepo(repoInput.value);
		const r = picked && tagSelect.value ? parseRelease(`${picked.owner}/${picked.repo}@${tagSelect.value}`) : null;
		const token = store.get(TOKEN);
		if (!r || !token) return;
		send.disabled = true;
		result.textContent = 'Submitting…';
		try {
			const res = await fetch(`${api}/submit`, {
				method: 'POST',
				headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
				body: JSON.stringify({ release_url: r.url, relationship: new FormData(form).get('relationship') }),
			});
			const data = await res.json();
			if (!res.ok) throw new Error(data.error ?? `The submit endpoint returned ${res.status}.`);
			result.innerHTML = '';
			result.append('Submitted to the registry. Follow the review in ');
			const a = Object.assign(document.createElement('a'), { href: data.issue_url, textContent: `issue #${data.issue_number}` });
			result.append(a, '.');
		} catch (err) {
			result.textContent = err instanceof Error ? err.message : String(err);
			send.disabled = false;
		}
	});

	loadAccount();
</script>

<style>
	.submit { max-width: 40rem; }
	.lede { font-size: var(--sl-text-lg); color: var(--sl-color-gray-1); }
	.notice { padding: 0.75rem 1rem; border-inline-start: 3px solid var(--sl-color-orange); background: var(--sl-color-orange-low); }
	form { display: grid; gap: 0.5rem; margin-top: 1.5rem; padding: 1.25rem; border: 1px solid var(--sl-color-gray-5); border-radius: 0.5rem; }
	.account { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem 1rem; padding-bottom: 1rem; margin-bottom: 0.5rem; border-bottom: 1px solid var(--sl-color-hairline); }
	label, legend { font-weight: 600; }
	fieldset { border: 0; padding: 0; margin: 0.75rem 0 0.5rem; display: grid; gap: 0.35rem; }
	fieldset label { font-weight: 400; display: flex; gap: 0.5rem; align-items: center; margin: 0; }
	.preview { margin: 0.25rem 0 0; padding: 0.6rem 0.8rem; font-family: var(--app-serif); font-size: var(--sl-text-lg); background: var(--sl-color-gray-7, var(--sl-color-gray-6)); border-radius: 0.35rem; }
	select, input[type='text'], #repo,
	input[type='url'] { font: inherit; padding: 0.55rem 0.7rem; color: var(--sl-color-white); background: var(--sl-color-bg); border: 1px solid var(--sl-color-gray-4); border-radius: 0.35rem; }
	.error { flex-basis: 100%; margin: 0; font-size: var(--sl-text-sm); color: var(--sl-color-red); }
	.hint, #result { margin: 0; font-size: var(--sl-text-sm); color: var(--sl-color-gray-3); }
	#result { color: var(--sl-color-white); min-height: 1.5em; }
	button { font: inherit; font-weight: 600; padding: 0.55rem 1.1rem; border-radius: 999px; border: 0; cursor: pointer; color: var(--sl-color-black); background: var(--sl-color-accent); justify-self: start; }
	button.secondary { background: transparent; color: var(--sl-color-white); border: 1px solid var(--sl-color-gray-4); }
	button.link { background: none; padding: 0; color: var(--sl-color-accent); font-weight: 400; text-decoration: underline; }
	button:disabled { opacity: 0.45; cursor: not-allowed; }
	button:focus-visible, input:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
</style>
