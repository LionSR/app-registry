---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { url } from '../lib/url';

// Set at build time. PUBLIC_SUBMIT_API is the function's base URL, e.g.
// https://<project-ref>.supabase.co/functions/v1/registry. Without these the page says submissions are not configured.
const api = import.meta.env.PUBLIC_SUBMIT_API ?? '';
const clientId = import.meta.env.PUBLIC_GITHUB_APP_CLIENT_ID ?? '';
const configured = Boolean(api && clientId);
---

<StarlightPage
	frontmatter={{
		title: 'Submit to the registry',
		template: 'splash',
		description: 'Add a published APP release to the registry so readers can find it.',
	}}
>
	<div class="submit" data-api={api} data-client-id={clientId}>
		<p class="lede">
			Add a paper you have <a href={url('/publish/')}>published with APP</a> to the list on this site. Nothing in your
			repository changes.
		</p>

		<section id="signin-step" class="card" aria-labelledby="signin-heading">
			<h2 id="signin-heading">Sign in with GitHub</h2>
			<p>Sign in so we know who is submitting. We only see your GitHub username and which repositories you can write to.</p>
			<button type="button" id="signin" disabled={!configured}>Sign in with GitHub</button>
			<p id="signin-status" class="status" data-tone="error" role="alert" hidden></p>
		</section>

		<form id="form" class="card" novalidate hidden>
			<div class="account">
				<span id="who"></span>
				<button type="button" id="signout" class="link">Sign out</button>
			</div>

			<label for="repo">Repository</label>
			<input id="repo" class="field" name="repo" required autocomplete="off" list="repo-suggestions" placeholder="owner/paper-repo" />
			<datalist id="repo-suggestions"></datalist>
			<p class="hint">A public GitHub repository. Type <code>owner/</code> to choose from its repositories, or paste a URL.</p>
			<p id="access" class="hint access" hidden></p>

			<label for="tag">Release</label>
			<select id="tag" class="field" name="tag" disabled><option>Choose a repository first</option></select>
			<p class="hint">Only releases made with the APP publishing workflow can be submitted.</p>

			<p id="preview" class="preview" hidden></p>

			<label id="permission-row" class="check" hidden>
				<input type="checkbox" id="permission" />
				<span>The authors agreed that I submit this paper. <span id="permission-why" class="hint"></span></span>
			</label>
			<label class="check">
				<input type="checkbox" id="terms" />
				<span>I agree to the <a href={url('/terms/')} target="_blank">terms of use</a>.</span>
			</label>

			<div id="status" class="status" data-tone="info" role="status" aria-live="polite"></div>
			<button type="submit" id="send" disabled>Submit to the registry</button>
		</form>

		<h2>After you submit</h2>
		<ol>
			<li>We check your release automatically, usually within a minute.</li>
			<li>If everything is in order, your paper is listed right away. If not, an editor takes a look first.</li>
			<li>GitHub notifies you about the review, and you can reply there. If something needs fixing, update your release and ask for a recheck.</li>
		</ol>

		<p class="agents">Submitting with a coding agent? See <a href={url('/agents/')}>For agents</a>.</p>
	</div>
</StarlightPage>

<script>
	import '../scripts/submit.ts';
</script>

<style>
	.submit { max-width: 40rem; }
	.agents { margin-top: 2rem; }
	.card { display: grid; gap: 0.5rem; margin-top: 1.5rem; padding: 1.25rem; border: 1px solid var(--sl-color-gray-5); border-radius: 0.5rem; }
	.card[hidden] { display: none; }
	.card h2 { margin: 0; font-size: var(--sl-text-xl); }
	.card p { margin: 0; }
	.account { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem 1rem; padding-bottom: 1rem; margin-bottom: 0.5rem; border-bottom: 1px solid var(--sl-color-hairline); }
	label { font-weight: 600; }
	label.check { font-weight: 400; display: flex; gap: 0.6rem; align-items: baseline; margin-top: 0.5rem; }
	label.check[hidden] { display: none; }
	label.check .hint { display: block; }
	.preview { margin: 0.25rem 0 0; padding: 0.6rem 0.8rem; font-family: var(--app-serif); font-size: var(--sl-text-lg); background: var(--sl-color-gray-6); border-radius: 0.35rem; }
	.status { margin-top: 0.75rem; padding: 0.7rem 0.9rem; border-radius: 0.4rem; border-inline-start: 3px solid; font-size: var(--sl-text-sm); line-height: 1.5; }
	.status:empty, .status[hidden] { display: none; }
	.status[data-tone='info'] { border-color: var(--sl-color-gray-4); background: var(--sl-color-gray-6); }
	.status[data-tone='ok'] { border-color: var(--sl-color-green); background: var(--sl-color-green-low); }
	.status[data-tone='warn'] { border-color: var(--sl-color-orange); background: var(--sl-color-orange-low); }
	.status[data-tone='error'] { border-color: var(--sl-color-red); background: var(--sl-color-red-low); }
	.status button.link { font-size: inherit; }
	.hint { margin: 0; font-size: var(--sl-text-sm); color: var(--sl-color-gray-3); }
	button { font: inherit; font-weight: 600; padding: 0.55rem 1.1rem; border-radius: 999px; border: 0; cursor: pointer; color: var(--sl-color-black); background: var(--sl-color-accent); justify-self: start; }
	button.secondary { background: transparent; color: var(--sl-color-white); border: 1px solid var(--sl-color-gray-4); }
	button.link { background: none; padding: 0; color: var(--sl-color-accent); font-weight: 400; text-decoration: underline; }
	button:disabled { opacity: 0.45; cursor: not-allowed; }
	button:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
</style>
