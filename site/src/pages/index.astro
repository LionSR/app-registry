---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { LinkButton } from '@astrojs/starlight/components';
import PaperRow from '../components/PaperRow.astro';
import Video from '../components/Video.astro';
import { url } from '../lib/url';
import { allPapers } from '../lib/papers';

const papers = await allPapers();
---

<StarlightPage
	frontmatter={{
		title: 'Instead of only publishing a paper, publish an agent.',
		template: 'splash',
		description: 'New papers published with the Agentic Publication Protocol. Each one is a GitHub repository you can open in a coding agent.',
		head: [{ tag: 'link', attrs: { rel: 'alternate', type: 'application/json', href: url('/papers/index.json') } }],
	}}
>
	<div class="catalog">
		<div class="intro">
			<div>
				<p class="lede">
					Every paper here comes with an AI agent that knows it. Open a paper in Claude Code or Codex and ask the agent to
					explain the work, reproduce a figure, or run an experiment. It answers from the paper, its code, and its data.
				</p>
				<div class="actions">
					<LinkButton href={url('/publish/')} icon="right-arrow">Publish your paper</LinkButton>
					<LinkButton href={url('/about/')} variant="secondary">Why APP</LinkButton>
				</div>
			</div>
			<Video src="/media/app-promo.mp4" poster="/media/app-promo.jpg" label="APP in 70 seconds" />
		</div>

		<h2 class="listing">New papers</h2>
		<ul class="recent">
			{papers.slice(0, 6).map((paper) => <PaperRow paper={paper} />)}
		</ul>
		<p><a href={url('/papers/')}>All {papers.length} papers</a></p>
	</div>
</StarlightPage>


<style>
	.catalog { max-width: 60rem; }
	.intro {
		display: grid;
		grid-template-columns: 1.25fr 1fr;
		gap: 1.5rem 2.5rem;
		align-items: center;
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--sl-color-hairline);
	}
	.lede { margin: 0; max-width: 34rem; }
	.actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.25rem; }
	@media (max-width: 50rem) { .intro { grid-template-columns: 1fr; } }
	.listing { margin-top: 2rem; font-size: var(--sl-text-2xl); }
	.recent { list-style: none; padding: 0; margin-top: 0.5rem; }
</style>
