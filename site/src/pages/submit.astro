---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Code } from '@astrojs/starlight/components';

// Set at build time. Without them the page explains that submissions are not configured.
const api = import.meta.env.PUBLIC_SUBMIT_API ?? '';
const clientId = import.meta.env.PUBLIC_GITHUB_APP_CLIENT_ID ?? '';
const configured = Boolean(api && clientId);
const agentCmd = `curl -X POST ${api || 'https://<submit-endpoint>'}/api/submit \\
  -H "Authorization: Bearer $(gh auth token)" \\
  -H "Content-Type: application/json" \\
  -d '{"release_url": "https://github.com/owner/repo/releases/tag/v1.0.0", "relationship": "author"}'`;
---

<StarlightPage
	frontmatter={{
		title: 'Submit to the registry',
		template: 'splash',
		description: 'List your APP release on this site.',
	}}
>
	<div class="submit" data-api={api} data-client-id={clientId}>
		<p class="lede">
			Submit a release you have already <a href="/publish/">published</a>. The registry checks that it is a verified APP
			publication, and an editor lists it with a permanent ID. Your repository is not changed.
		</p>

		{
			!configured && (
				<p class="notice">Submissions are not configured on this build of the site.</p>
			)
		}

		<form id="form" novalidate>
			<div class="account">
				<span id="who">Sign in with GitHub so the registry knows who is submitting.</span>
				<button type="button" id="signin" class="secondary" disabled={!configured}>Sign in with GitHub</button>
				<button type="button" id="signout" class="link" hidden>Sign out</button>
			</div>

			<label for="release">Release URL</label>
			<input id="release" name="release" type="url" required placeholder="https://github.com/owner/repo/releases/tag/v1.0.0" autocomplete="off" />
			<p id="preview" class="hint">Paste the link to the GitHub release that carries your APP_PUBLICATION.json.</p>

			<fieldset>
				<legend>Your relationship to the paper</legend>
				<label><input type="radio" name="relationship" value="author" checked /> I am an author</label>
				<label><input type="radio" name="relationship" value="coauthor" /> I am a co-author</label>
				<label><input type="radio" name="relationship" value="on-behalf" /> I am submitting on behalf of the authors</label>
			</fieldset>

			<button type="submit" id="send" disabled>Submit to the registry</button>
			<p id="result" role="status" aria-live="polite"></p>
		</form>

		<h2>What happens next</h2>
		<ol>
			<li>A submission issue opens in the registry repository, and you are mentioned in it.</li>
			<li>The checks run within a minute and post the result there. If something fails, fix the release and comment <code>/recheck</code>.</li>
			<li>An editor reviews the submission and lists it, or replies with a reason. Reply in the same issue to respond.</li>
		</ol>

		<h2>Submit from an agent</h2>
		<p>Agents use the same endpoint. The GitHub CLI token identifies you.</p>
		<Code code={agentCmd} lang="bash" />
	</div>
</StarlightPage>

<script>
	import { parseRelease } from '../../../submit/lib/submission.ts';

	const root = document.querySelector<HTMLElement>('.submit')!;
	const api = root.dataset.api!;
	const clientId = root.dataset.clientId!;
	const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
	const form = $<HTMLFormElement>('form');
	const release = $<HTMLInputElement>('release');
	const preview = $('preview');
	const send = $<HTMLButtonElement>('send');
	const result = $('result');
	const who = $('who');
	const TOKEN = 'app-registry-token';
	const STATE = 'app-registry-oauth-state';

	const store = {
		get: (k: string) => { try { return sessionStorage.getItem(k); } catch { return null; } },
		set: (k: string, v: string) => { try { sessionStorage.setItem(k, v); } catch {} },
		del: (k: string) => { try { sessionStorage.removeItem(k); } catch {} },
	};

	// Back from GitHub sign-in: the callback puts the token (or an error) in the fragment.
	const back = new URLSearchParams(location.hash.slice(1));
	if (back.has('state')) {
		history.replaceState(null, '', location.pathname);
		if (back.get('state') !== store.get(STATE)) result.textContent = 'Sign-in could not be verified. Sign in again.';
		else if (back.get('error')) result.textContent = back.get('error')!;
		else if (back.get('token')) store.set(TOKEN, back.get('token')!);
		store.del(STATE);
	}

	let login = '';
	async function loadAccount() {
		const token = store.get(TOKEN);
		if (!token) return;
		const res = await fetch('https://api.github.com/user', { headers: { Authorization: `Bearer ${token}` } });
		if (!res.ok) return store.del(TOKEN);
		login = (await res.json()).login;
		who.textContent = `Signed in as @${login}`;
		$('signin').hidden = true;
		$('signout').hidden = false;
		update();
	}

	$('signin').addEventListener('click', () => {
		const state = crypto.randomUUID();
		store.set(STATE, state);
		const q = new URLSearchParams({ client_id: clientId, redirect_uri: `${api}/api/auth/callback`, state });
		location.href = `https://github.com/login/oauth/authorize?${q}`;
	});
	$('signout').addEventListener('click', () => {
		store.del(TOKEN);
		location.reload();
	});

	// Preview what the release says about itself. The real checks run after submission.
	let previewFor = '';
	async function update() {
		const r = parseRelease(release.value);
		send.disabled = !(r && login);
		if (!r) {
			preview.textContent = release.value.trim()
				? 'Use the release link, like https://github.com/owner/repo/releases/tag/v1.0.0.'
				: 'Paste the link to the GitHub release that carries your APP_PUBLICATION.json.';
			return;
		}
		if (previewFor === r.url) return;
		previewFor = r.url;
		preview.textContent = `Reading AGENTS.md at ${r.tag}…`;
		const res = await fetch(`https://raw.githubusercontent.com/${r.owner}/${r.repo}/${encodeURIComponent(r.tag)}/AGENTS.md`);
		if (previewFor !== r.url) return;
		if (!res.ok) {
			preview.textContent = `No AGENTS.md found in ${r.owner}/${r.repo} at ${r.tag}. Check the link; the checks will fail without it.`;
			return;
		}
		const text = await res.text();
		const title = text.match(/^title:\s*["']?(.*?)["']?\s*$/m)?.[1];
		const names = [...text.matchAll(/^\s*-\s+name:\s*["']?(.*?)["']?\s*$/gm)].map((m) => m[1]);
		preview.textContent = title ? `${title}${names.length ? `, by ${names.join(', ')}` : ''}` : `Found AGENTS.md in ${r.owner}/${r.repo} at ${r.tag}.`;
	}
	release.addEventListener('input', update);

	form.addEventListener('submit', async (e) => {
		e.preventDefault();
		const r = parseRelease(release.value);
		const token = store.get(TOKEN);
		if (!r || !token) return;
		send.disabled = true;
		result.textContent = 'Submitting…';
		try {
			const res = await fetch(`${api}/api/submit`, {
				method: 'POST',
				headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
				body: JSON.stringify({ release_url: r.url, relationship: new FormData(form).get('relationship') }),
			});
			const data = await res.json();
			if (!res.ok) throw new Error(data.error ?? `The submit endpoint returned ${res.status}.`);
			result.innerHTML = '';
			result.append('Submitted to the registry. Follow the review in ');
			const a = Object.assign(document.createElement('a'), { href: data.issue_url, textContent: `issue #${data.issue_number}` });
			result.append(a, '.');
		} catch (err) {
			result.textContent = err instanceof Error ? err.message : String(err);
			send.disabled = false;
		}
	});

	loadAccount();
</script>

<style>
	.submit { max-width: 40rem; }
	.lede { font-size: var(--sl-text-lg); color: var(--sl-color-gray-1); }
	.notice { padding: 0.75rem 1rem; border-inline-start: 3px solid var(--sl-color-orange); background: var(--sl-color-orange-low); }
	form { display: grid; gap: 0.5rem; margin-top: 1.5rem; padding: 1.25rem; border: 1px solid var(--sl-color-gray-5); border-radius: 0.5rem; }
	.account { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem 1rem; padding-bottom: 1rem; margin-bottom: 0.5rem; border-bottom: 1px solid var(--sl-color-hairline); }
	label, legend { font-weight: 600; }
	fieldset { border: 0; padding: 0; margin: 0.75rem 0 0.5rem; display: grid; gap: 0.35rem; }
	fieldset label { font-weight: 400; display: flex; gap: 0.5rem; align-items: center; margin: 0; }
	input[type='url'] { font: inherit; padding: 0.55rem 0.7rem; color: var(--sl-color-white); background: var(--sl-color-bg); border: 1px solid var(--sl-color-gray-4); border-radius: 0.35rem; }
	.hint, #result { margin: 0; font-size: var(--sl-text-sm); color: var(--sl-color-gray-3); }
	#result { color: var(--sl-color-white); min-height: 1.5em; }
	button { font: inherit; font-weight: 600; padding: 0.55rem 1.1rem; border-radius: 999px; border: 0; cursor: pointer; color: var(--sl-color-black); background: var(--sl-color-accent); justify-self: start; }
	button.secondary { background: transparent; color: var(--sl-color-white); border: 1px solid var(--sl-color-gray-4); }
	button.link { background: none; padding: 0; color: var(--sl-color-accent); font-weight: 400; text-decoration: underline; }
	button:disabled { opacity: 0.45; cursor: not-allowed; }
	button:focus-visible, input:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
</style>
