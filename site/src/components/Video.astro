---
import { url } from '../lib/url';

const props = Astro.props as { src: string; poster: string; label: string };
// Accept site paths like /media/x.mp4 and apply the base.
const src = props.src.startsWith('/') ? url(props.src) : props.src;
const poster = props.poster.startsWith('/') ? url(props.poster) : props.poster;
const { label } = props;
---

<figure class="video">
	<video controls preload="none" playsinline poster={poster} aria-label={label}>
		<source src={src} type="video/mp4" />
	</video>
</figure>

<style>
	.video { margin: 0; }
	video { width: 100%; aspect-ratio: 16 / 9; display: block; border-radius: 0.4rem; background: #000; }
</style>
